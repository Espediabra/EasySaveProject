<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySaveProject.UI.Avalonia.ViewModels"
        x:Class="EasySaveProject.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EasySave"
        Width="960"
        Height="640"
        MinWidth="800"
        MinHeight="520"
        Background="#FEFCF7"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="210,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#2B2118">

            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top"
                        Padding="20,24,20,20"
                        BorderBrush="#3D3228"
                        BorderThickness="0,0,0,1">

                    <StackPanel Spacing="2">
                        <TextBlock Text="EasySave"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#AF9164"/>

                        <TextBlock Text="Gestionnaire de sauvegardes"
                                   FontSize="11"
                                   Foreground="#8A7D6E"/>
                    </StackPanel>

                </Border>

                <!-- Navigation -->
                <StackPanel Margin="12,20,12,0"
                            Spacing="6">

                    <Button Classes="navbutton"
                            HorizontalAlignment="Stretch"
                            Content="⬛  Sauvegardes"/>

                    <Button Classes="navbutton"
                            HorizontalAlignment="Stretch"
                            Content="📋  Journaux"/>

                    <Button Classes="navbutton"
                            HorizontalAlignment="Stretch"
                            Content="⚙  Paramètres"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">

            <StackPanel Margin="28"
                        Spacing="16">

                <TextBlock Classes="heading"
                           Text="Bienvenue sur EasySave"/>

                <TextBlock Classes="subheading"
                           Text="Votre nouvelle interface Avalonia fonctionne."/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>