<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EasySaveProject.UI.Avalonia.ViewModels"
             xmlns:views="clr-namespace:EasySaveProject.UI.Avalonia.Views"
             x:Class="EasySaveProject.UI.Avalonia.Views.JobsPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- ─── Liste des jobs ───────────────────────────────────────────── -->
        <DockPanel Grid.Column="0">

            <!-- HEADER -->
            <Border DockPanel.Dock="Top"
                    Padding="28,24,28,16"
                    BorderBrush="#E8E4D6"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="heading"
                                   Text="{Binding Loc[Jobs.Title]}" />

                        <TextBlock Classes="subheading"
                                   Text="{Binding Loc[Jobs.Subtitle]}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                        <Button Classes="secondary"
                                Content="{Binding Loc[Jobs.RunSelected]}"
                                IsVisible="{Binding HasSelectedJobs}"
                                Command="{Binding RunSelectedJobsCommand}" />

                        <Button Classes="primary"
                                Content="{Binding Loc[Jobs.New]}"
                                Command="{Binding OpenCreateFormCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SEARCH -->
            <Border DockPanel.Dock="Top"
                    Padding="28,16,28,10"
                    BorderBrush="#E8E4D6"
                    BorderThickness="0,0,0,1">

                <TextBox Text="{Binding SearchJobs}"
                         PlaceholderText="{Binding Loc[Jobs.Search]}"
                         Height="38"
                         FontSize="13"
                         Background="#FEFCF7"
                         BorderBrush="#E8E4D6"
                         CornerRadius="8"/>
            </Border>

            <!-- CREATE FORM -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding ShowCreateForm}"
                    Background="#F7F3E3"
                    BorderBrush="#E8E4D6"
                    BorderThickness="0,0,0,1"
                    Padding="28,20">

                <StackPanel Spacing="14"
                            MaxWidth="560"
                            HorizontalAlignment="Left">

                    <TextBlock Text="{Binding Loc[Form.NewBackup]}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#2B2118" />

                    <Grid ColumnDefinitions="*,16,180">

                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="label"
                                       Text="{Binding Loc[Form.Name]}" />

                            <TextBox Text="{Binding FormName}"
                                     PlaceholderText="{Binding Loc[Form.NamePlaceholder]}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label"
                                       Text="{Binding Loc[Form.Type]}" />

                            <ComboBox SelectedIndex="{Binding FormTypeIndex}">
                                <ComboBoxItem Content="Full" />
                                <ComboBoxItem Content="Differential" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Classes="label"
                                   Text="{Binding Loc[Form.Source]}" />

                        <TextBox Text="{Binding FormSource}"
                                 PlaceholderText="C:/Users/…" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label"
                                   Text="{Binding Loc[Form.Target]}" />

                        <TextBox Text="{Binding FormTarget}"
                                 PlaceholderText="D:/Backups/…" />
                    </StackPanel>

                    <TextBlock Text="{Binding FormError}"
                               IsVisible="{Binding FormError, Converter={x:Static views:NotEmptyConverter.Instance}}"
                               Foreground="#6F1A07"
                               FontSize="12" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <Button Classes="primary"
                                Content="{Binding Loc[Form.Create]}"
                                Command="{Binding SubmitCreateCommand}" />

                        <Button Classes="secondary"
                                Content="{Binding Loc[Form.Cancel]}"
                                Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RUN NOW -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding ShowRunNowPrompt}"
                    Background="#EDF7EE"
                    BorderBrush="#9BC99E"
                    BorderThickness="0,0,0,1"
                    Padding="28,16">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel VerticalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="{Binding RunNowJobTitle}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#2B4A2D" />

                        <TextBlock Text="{Binding Loc[RunNow.Question]}"
                                   FontSize="12"
                                   Foreground="#3D7A40" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">

                        <Button Classes="primary"
                                Content="{Binding Loc[RunNow.Run]}"
                                Command="{Binding RunNowCommand}" />

                        <Button Classes="secondary"
                                Content="{Binding Loc[RunNow.Later]}"
                                Command="{Binding DismissRunNowCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Margin="28,16,28,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10">

                    <!-- EMPTY -->
                    <Border IsVisible="{Binding Jobs.Count, Converter={x:Static views:ZeroToBoolConverter.Instance}}"
                            Padding="28,48">

                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="8">

                            <TextBlock Text="{Binding Loc[Jobs.Empty]}"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="#2B2118"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding Loc[Jobs.Empty.Sub]}"
                                       Foreground="#B3B6B7"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- LIST -->
                    <ItemsControl ItemsSource="{Binding FilteredJobs}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BackupJobViewModel" x:CompileBindings="False">
                                <Border Background="#FEFCF7"
                                        BorderBrush="#E8E4D6"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,10"
                                        Padding="16,14"
                                        Cursor="Hand">

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Exécuter"
                                                      Command="{Binding $parent[UserControl].DataContext.RunJobCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Supprimer"
                                                      Command="{Binding $parent[UserControl].DataContext.DeleteJobCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <!-- Case à cocher multi-sélection -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,12,0" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Grid ColumnDefinitions="Auto,8,Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="#2B2118" />
                                                <!-- Badge type -->
                                                <Border Grid.Column="2"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Background="#F1E8D8">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               FontSize="11"
                                                               Foreground="#AF9164" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding SourcePath}"
                                                       FontSize="12"
                                                       Foreground="#B3B6B7"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />

                                            <!-- Barre de progression -->
                                            <StackPanel IsVisible="{Binding IsRunning}" Margin="0,6,0,0" Spacing="4">
                                                <ProgressBar Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="3"
                                                             CornerRadius="2"
                                                             Background="#E8E4D6"
                                                             Foreground="#AF9164" />
                                                <TextBlock Text="{Binding ProgressText}"
                                                           FontSize="11"
                                                           Foreground="#B3B6B7" />
                                            </StackPanel>

                                            <!-- Badge terminé -->
                                            <Border IsVisible="{Binding IsCompleted}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Background="#E4F0E5"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DataContext.Loc[Jobs.Status.DoneLabel],
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                FontSize="11"
                                                Foreground="#3D7A40" />
                                            </Border>

                                            <!-- Badge erreur -->
                                            <Border IsVisible="{Binding IsError}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Background="#F5E0DC"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DataContext.Loc[Jobs.Status.ErrorLabel],
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                FontSize="11"
                                                Foreground="#6F1A07" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Boutons action -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Classes="primary"
                                                    Content="{Binding DataContext.Loc[Jobs.Run], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    FontSize="12"
                                                    Padding="10,6"
                                                    Command="{Binding $parent[UserControl].DataContext.RunJobCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsRunning}" />
                                            <Button Classes="icon"
                                                    Command="{Binding $parent[UserControl].DataContext.SelectJobCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Détails">
                                                <TextBlock Text="›"
                                                           FontSize="18"
                                                           Foreground="#B3B6B7" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>

        <!-- ─── Panel de détail ──────────────────────────────────────────── -->
        <Border Grid.Column="1"
                IsVisible="{Binding ShowJobPanel}"
                Width="300"
                BorderBrush="#E8E4D6"
                BorderThickness="1,0,0,0"
                Background="#F7F3E3">

            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="20,18,12,14"
                        BorderBrush="#E8E4D6"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Loc[Jobs.Status.DoneLabel]}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#2B2118"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="icon"
                                Content="✕"
                                Command="{Binding CloseJobPanelCommand}" />
                    </Grid>
                </Border>

                <ScrollViewer DockPanel.Dock="Top" Padding="20,16">
                    <StackPanel Spacing="16"
                                x:CompileBindings="False"
                                IsVisible="{Binding SelectedJob, Converter={x:Static views:NotNullConverter.Instance}}"
                                DataContext="{Binding SelectedJob}">

                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding DataContext.Loc[Jobs.Name_v2], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#2B2118"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Separator />

                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding DataContext.Loc[Jobs.Type_v2], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <ComboBox Grid.Column="0"
                                          SelectedIndex="{Binding PendingTypeIndex}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Full" />
                                    <ComboBoxItem Content="Differential" />
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Content="✓"
                                        Margin="8,0,0,0"
                                        Padding="10,6"
                                        ToolTip.Tip="Enregistrer le type"
                                        Command="{Binding $parent[UserControl].DataContext.SaveJobTypeCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding DataContext.Loc[Jobs.Source_v2], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding SourcePath}"
                                       FontSize="12"
                                       Foreground="#2B2118"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Separator />

                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding DataContext.Loc[Jobs.Target_v2], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding TargetPath}"
                                       FontSize="12"
                                       Foreground="#2B2118"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Separator />

                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding DataContext.Loc[Jobs.Status_v2], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="13"
                                       Foreground="#2B2118" />
                        </StackPanel>

                        <Separator />

                        <StackPanel Spacing="8">
                            <Button Classes="primary"
                                    Content="{Binding DataContext.Loc[Jobs.RunNow], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding $parent[UserControl].DataContext.RunJobCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding !IsRunning}" />
                            <Button Classes="danger"
                                    Content="{Binding DataContext.Loc[Jobs.Remove], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding $parent[UserControl].DataContext.DeleteJobCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>

</UserControl>
