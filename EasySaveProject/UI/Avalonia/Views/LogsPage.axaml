<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EasySaveProject.UI.Avalonia.ViewModels"
             xmlns:views="clr-namespace:EasySaveProject.UI.Avalonia.Views"
             x:Class="EasySaveProject.UI.Avalonia.Views.LogsPage"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>

        <!-- En-tête -->
        <Border DockPanel.Dock="Top"
                Padding="28,24,28,16"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="heading" Text="Journaux" />
                    <TextBlock Classes="subheading"
                               Text="Historique des opérations de sauvegarde"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Filtrer :"
                               FontSize="13"
                               Foreground="#B3B6B7"
                               VerticalAlignment="Center" />
                    <ComboBox SelectedValue="{Binding SelectedLogLevel}"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Info"/>
                        <ComboBoxItem Content="Warning"/>
                        <ComboBoxItem Content="Error"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre de recherche -->
        <Border DockPanel.Dock="Top"
                Padding="28,16,28,10"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">

            <TextBox Text="{Binding SearchLogs}"
                     PlaceholderText="Rechercher un job, message ou niveau..."
                     Height="38"
                     FontSize="13"
                     Background="#FEFCF7"
                     BorderBrush="#E8E4D6"
                     CornerRadius="8"/>
        </Border>

        <!-- Table des logs -->
        <Grid RowDefinitions="Auto,*"
              DockPanel.Dock="Top"
              Margin="28,16,28,24">

            <!-- HEADER FIXE -->
            <StackPanel Grid.Row="0"
                        Spacing="2">

                <Grid ColumnDefinitions="80,80,140,*,80,80"
                      Margin="0,0,0,6">

                    <TextBlock Grid.Column="0"
                               Classes="muted"
                               Text="HEURE" />

                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               Text="NIVEAU" />

                    <TextBlock Grid.Column="2"
                               Classes="muted"
                               Text="JOB" />

                    <TextBlock Grid.Column="3"
                               Classes="muted"
                               Text="MESSAGE" />

                    <TextBlock Grid.Column="4"
                               Classes="muted"
                               Text="TAILLE" />

                    <TextBlock Grid.Column="5"
                               Classes="muted"
                               Text="DURÉE" />

                </Grid>

                <Separator Margin="0,0,0,4"/>

            </StackPanel>

            <!-- TABLE SCROLLABLE -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FilteredLogs}"
                     Background="#FAFAFA"
                     BorderBrush="#E8E4D6"
                     BorderThickness="1"
                     CornerRadius="10">

                <ListBox.Styles>

                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>

                    <Style Selector="ListBoxItem:pointerover Border.row">
                        <Setter Property="Background" Value="#F7F3E3"/>
                    </Style>

                    <Style Selector="ListBoxItem:selected Border.row">
                        <Setter Property="Background" Value="#EDE4D1"/>
                    </Style>

                </ListBox.Styles>

                <ListBox.ItemTemplate>

                    <DataTemplate DataType="vm:LogEntryViewModel">

                        <Border Classes="row"
                                Background="#FEFCF7"
                                BorderBrush="#E8E4D6"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">

                            <Grid ColumnDefinitions="80,90,160,*,90,90">

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TimeFormatted}"
                                           FontSize="12"
                                           Foreground="#B3B6B7"
                                           FontFamily="Consolas"/>

                                <Border Grid.Column="1"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        HorizontalAlignment="Left">

                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding LevelBg}" />
                                    </Border.Background>

                                    <TextBlock Text="{Binding Level}"
                                               FontSize="11"
                                               FontWeight="SemiBold">

                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding LevelColor}" />
                                        </TextBlock.Foreground>

                                    </TextBlock>

                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding JobName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2118"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           FontSize="13"
                                           Foreground="#6B6256"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding SizeFormatted}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="#B3B6B7"/>

                                <TextBlock Grid.Column="5"
                                           Text="{Binding TransferFormatted}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="#B3B6B7"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>
    </DockPanel>

</UserControl>
