<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EasySaveProject.UI.Avalonia.ViewModels"
             xmlns:views="clr-namespace:EasySaveProject.UI.Avalonia.Views"
             x:Class="EasySaveProject.UI.Avalonia.Views.LogsPage"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>

        <!-- En-tête -->
        <Border DockPanel.Dock="Top"
                Padding="28,24,28,16"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="heading" Text="{Binding Loc[Logs.Title]}" />
                    <TextBlock Classes="subheading"
                               Text="{Binding Loc[Logs.Subtitle]}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[Logs.Filter]}"
                               FontSize="13"
                               Foreground="#B3B6B7"
                               VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{Binding SelectedLogLevelIndex}"
                              ItemsSource="{Binding LogLevelOptions}"
                              Width="120"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sélecteur de date -->
        <Border DockPanel.Dock="Top"
                Padding="28,14,28,14"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1"
                Background="#FEFCF7">

            <Grid ColumnDefinitions="Auto,12,Auto,12,Auto,16,Auto,*,Auto">

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Loc[Logs.Date.Day]}"
                               FontSize="11"
                               Foreground="#B3B6B7"/>
                    <NumericUpDown Value="{Binding LogsDay}"
                                   Minimum="1" Maximum="31"
                                   FormatString="0"
                                   Width="68" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding Loc[Logs.Date.Month]}"
                               FontSize="11"
                               Foreground="#B3B6B7"/>
                    <NumericUpDown Value="{Binding LogsMonth}"
                                   Minimum="1" Maximum="12"
                                   FormatString="0"
                                   Width="68" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="3">
                    <TextBlock Text="{Binding Loc[Logs.Date.Year]}"
                               FontSize="11"
                               Foreground="#B3B6B7"/>
                    <NumericUpDown Value="{Binding LogsYear}"
                                   Minimum="2000" Maximum="2100"
                                   FormatString="0"
                                   Width="90" Height="36"/>
                </StackPanel>

                <Button Grid.Column="6"
                        Classes="primary"
                        Content="{Binding Loc[Logs.Date.Load]}"
                        Command="{Binding LoadLogsByDateCommand}"
                        VerticalAlignment="Bottom"
                        Height="36"/>

                <TextBlock Grid.Column="8"
                           Text="{Binding LogsDateLabel}"
                           FontSize="13"
                           Foreground="#6B6256"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </Grid>
        </Border>

        <!-- Barre de recherche -->
        <Border DockPanel.Dock="Top"
                Padding="28,12,28,10"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">

            <TextBox Text="{Binding SearchLogs}"
                     PlaceholderText="{Binding Loc[Logs.Search]}"
                     Height="38"
                     FontSize="13"
                     Background="#FEFCF7"
                     BorderBrush="#E8E4D6"
                     CornerRadius="8"/>
        </Border>

        <!-- Table des logs -->
        <Grid RowDefinitions="Auto,*"
              DockPanel.Dock="Top"
              Margin="28,16,28,24">

            <!-- HEADER FIXE -->
            <StackPanel Grid.Row="0"
                        Spacing="2">

                <Grid ColumnDefinitions="100,85,155,*,120,120"
                      Margin="0,0,0,6">

                    <TextBlock Grid.Column="0"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.Time]}" />

                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.Level]}" />

                    <TextBlock Grid.Column="2"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.Job]}" />

                    <TextBlock Grid.Column="3"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.Message]}" />

                    <TextBlock Grid.Column="4"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.FileSize]}" />

                    <TextBlock Grid.Column="5"
                               Classes="muted"
                               Text="{Binding Loc[Logs.Header.TransferTime]}" />

                </Grid>

                <Separator Margin="0,0,0,4"/>

            </StackPanel>

            <!-- TABLE SCROLLABLE -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FilteredLogs}"
                     Background="#FAFAFA"
                     BorderBrush="#E8E4D6"
                     BorderThickness="1"
                     CornerRadius="10">

                <ListBox.Styles>

                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>

                    <Style Selector="ListBoxItem:pointerover Border.row">
                        <Setter Property="Background" Value="#F7F3E3"/>
                    </Style>

                    <Style Selector="ListBoxItem:selected Border.row">
                        <Setter Property="Background" Value="#EDE4D1"/>
                    </Style>

                </ListBox.Styles>

                <ListBox.ItemTemplate>

                    <DataTemplate DataType="vm:LogEntryViewModel">

                        <Border Classes="row"
                                Background="#FEFCF7"
                                BorderBrush="#E8E4D6"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">

                            <Grid ColumnDefinitions="80,90,160,*,120,120">

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TimeFormatted}"
                                           FontSize="12"
                                           Foreground="#B3B6B7"
                                           FontFamily="Consolas"/>

                                <Border Grid.Column="1"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        HorizontalAlignment="Left">

                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding LevelBg}" />
                                    </Border.Background>

                                    <TextBlock Text="{Binding Level}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#2B2118"
                                               />

                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding JobName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2118"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           FontSize="13"
                                           Foreground="#6B6256"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding SizeFormatted}"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           Foreground="#B3B6B7"/>

                                <TextBlock Grid.Column="5"
                                           Text="{Binding TransferFormatted}"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           Foreground="#B3B6B7"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>
    </DockPanel>

</UserControl>
