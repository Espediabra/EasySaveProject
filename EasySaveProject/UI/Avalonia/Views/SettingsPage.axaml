<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EasySaveProject.UI.Avalonia.ViewModels"
             x:Class="EasySaveProject.UI.Avalonia.Views.SettingsPage"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Padding="28,24,28,16"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Classes="heading" Text="{Binding Loc[Settings.Title]}" />
                <TextBlock Classes="subheading"
                           Text="{Binding Loc[Settings.Subtitle]}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- SEARCH -->
        <Border DockPanel.Dock="Top"
                Padding="28,16,28,10"
                BorderBrush="#E8E4D6"
                BorderThickness="0,0,0,1">

            <TextBox Text="{Binding SearchSettings}"
                     PlaceholderText="{Binding Loc[Settings.Search]}"
                     Height="38"
                     FontSize="13"
                     Background="#FEFCF7"
                     BorderBrush="#E8E4D6"
                     CornerRadius="8"/>
        </Border>

        <!-- SETTINGS LIST -->
        <ScrollViewer DockPanel.Dock="Top"
                      Margin="28,16,28,24">

            <StackPanel Spacing="12">

                <!-- LANGUE -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowLanguageSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.Language]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.Language.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <Grid ColumnDefinitions="*,Auto">

                            <ComboBox Grid.Column="0"
                                      Width="200"
                                      SelectedIndex="{Binding LanguageIndex}">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Français"/>
                            </ComboBox>

                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.Save]}"
                                    Command="{Binding SaveLanguageCommand}"
                                    IsEnabled="{Binding CanChangeLanguage}"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- LOG FORMAT -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowLogFormatSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.LogFormat.Title]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.LogFormat.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <Grid ColumnDefinitions="*,Auto">

                            <ComboBox Grid.Column="0"
                                      Width="200"
                                      SelectedItem="{Binding SelectedLogFormat}"
                                      ItemsSource="{Binding LogFormats}"/>

                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.LogFormat.Save]}"
                                    Command="{Binding SaveLogFormatCommand}"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- BUSINESS SOFTWARE -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowBusinessSoftwareSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.BusinessSoftware.Title]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.BusinessSoftware.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <!-- Ajout -->
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewBusinessSoftware}"
                                     PlaceholderText="{Binding Loc[Settings.BusinessSoftware.Placeholder]}" />

                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.BusinessSoftware.Add]}"
                                    Command="{Binding AddBusinessSoftwareCommand}" />

                        </Grid>

                        <!-- Liste -->
                        <ItemsControl ItemsSource="{Binding BusinessSoftware}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="#E8E4D6"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,4,0,0">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <TextBlock Text="{Binding .}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="{Binding $parent[UserControl].DataContext.Loc[Settings.BusinessSoftware.Remove]}"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveBusinessSoftwareCommand}"
                                                    CommandParameter="{Binding .}"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- PRIORITY EXTENSIONS -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowPriorityExtensionsSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.PriorityExtensions.Title]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.PriorityExtensions.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewPriorityExtension}"
                                     PlaceholderText="{Binding Loc[Settings.PriorityExtensions.Placeholder]}" />
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.PriorityExtensions.Add]}"
                                    Command="{Binding AddPriorityExtensionCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PriorityExtensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E8E4D6"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding .}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="{Binding $parent[UserControl].DataContext.Loc[Settings.PriorityExtensions.Remove]}"
                                                    Command="{Binding $parent[UserControl].DataContext.RemovePriorityExtensionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- LARGE FILE THRESHOLD -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowLargeFileThresholdSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.LargeFileThreshold.Title]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.LargeFileThreshold.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <Grid ColumnDefinitions="*,Auto">
                            <NumericUpDown Grid.Column="0"
                                           Value="{Binding LargeFileThresholdKb}"
                                           Minimum="0"
                                           Increment="1000"
                                           FormatString="0"
                                           Watermark="0 = disabled"
                                           Width="200"/>
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.LargeFileThreshold.Save]}"
                                    Command="{Binding SaveLargeFileThresholdCommand}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- LOG CENTRALIZATION -->
                <Border Classes="row"
                        Background="#FEFCF7"
                        BorderBrush="#E8E4D6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,18"
                        IsVisible="{Binding ShowLogModeSetting}">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings.LogMode.Title]}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding Loc[Settings.LogMode.Desc]}"
                                       FontSize="12"
                                       Foreground="#B3B6B7"/>
                        </StackPanel>

                        <Separator/>

                        <!-- Mode selection -->
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0"
                                      Width="240"
                                      SelectedItem="{Binding SelectedLogMode}"
                                      ItemsSource="{Binding LogModes}"/>
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="{Binding Loc[Settings.LogMode.Save]}"
                                    Command="{Binding SaveLogModeCommand}"/>
                        </Grid>

                        <!-- Server settings (host/port) — shown for Remote and Both modes -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Loc[Settings.LogMode.Host]}"
                                               FontSize="12"
                                               Foreground="#B3B6B7"/>
                                    <TextBox Text="{Binding LogServerHost}"
                                             Watermark="localhost"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{Binding Loc[Settings.LogMode.Port]}"
                                               FontSize="12"
                                               Foreground="#B3B6B7"/>
                                    <NumericUpDown Value="{Binding LogServerPort}"
                                                   Minimum="1"
                                                   Maximum="65535"
                                                   FormatString="0"/>
                                </StackPanel>
                            </Grid>
                            <Button Classes="secondary"
                                    Content="{Binding Loc[Settings.LogMode.Save]}"
                                    Command="{Binding SaveLogServerSettingsCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

    </DockPanel>

</UserControl>