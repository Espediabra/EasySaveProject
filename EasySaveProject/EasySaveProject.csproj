<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
  <None Include="..\CryptoSoft\CryptoSoft.exe">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
</ItemGroup>

  <ItemGroup>
    <None Include="Core\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\Config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\Jobs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\State\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EasyLog">
      <HintPath>..\EasyLog\bin\Debug\net10.0\EasyLog.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="state.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
	  
  </ItemGroup>
	<Target Name="PublishWin">
		<Exec Command="dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true" />
	</Target>

	<Target Name="PublishLinux">
		<Exec Command="dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true" />
	</Target>
	
</Project>
