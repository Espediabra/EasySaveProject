<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <NoWarn>CS8618</NoWarn>

    <!-- <ApplicationManifest>app.manifest</ApplicationManifest> -->

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <!-- ───────────────────────────── -->
  <!-- Packages -->
  <!-- ───────────────────────────── -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />

    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ───────────────────────────── -->
  <!-- Références projets -->
  <!-- ───────────────────────────── -->

  <ItemGroup>
    <ProjectReference Include="..\EasyLog\EasyLog.csproj" />
  </ItemGroup>

  <!-- ───────────────────────────── -->
  <!-- Ressources -->
  <!-- ───────────────────────────── -->

  <ItemGroup>

    <None Include="..\CryptoSoft\CryptoSoft.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Core\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\Config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\Jobs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Data\State\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

  </ItemGroup>

  <!-- ───────────────────────────── -->
  <!-- Executable reference -->
  <!-- ───────────────────────────── -->

  	<Target Name="PublishWin">
      <Exec Command="dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true" />
    </Target>

	<Target Name="PublishLinux">
		<Exec Command="dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true" />
	</Target>

</Project>