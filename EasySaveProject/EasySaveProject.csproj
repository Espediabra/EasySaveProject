<Project Sdk="Microsoft.NET.Sdk">

  <!-- =======================
       PROPERTIES
  ======================== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>EasySaveProject</RootNamespace>
    <AssemblyName>EasySave</AssemblyName>

    <NoWarn>CS8618</NoWarn>

    <!-- Avalonia -->
    <AvaloniaVersion>12.0.3</AvaloniaVersion>
  </PropertyGroup>


  <!-- =======================
       PACKAGE REFERENCES
  ======================== -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>


  <!-- =======================
       PROJECT REFERENCES
  ======================== -->
  <ItemGroup>
    <ProjectReference Include="..\EasyLog\EasyLog.csproj" />
  </ItemGroup>


  <!-- =======================
       EXTERNAL FILES (EXE)
  ======================== -->
  <ItemGroup>
    <None Include="..\CryptoSoft\CryptoSoft.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <!-- =======================
       JSON DATA FILES
  ======================== -->
  <ItemGroup>
    <None Include="Core\Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Config\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Jobs\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\State\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- =======================
       SPECIFIC FILES
  ======================== -->
  <ItemGroup>
    <None Update="state.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <!-- =======================
       PUBLISH TARGETS
  ======================== -->
  <Target Name="PublishWin">
    <Exec Command="dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true" />
  </Target>

  <Target Name="PublishLinux">
    <Exec Command="dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true" />
  </Target>

</Project>